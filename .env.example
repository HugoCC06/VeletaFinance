# Copy to .env.local for local development. Never commit real values.
#
# Public values (safe to expose in the browser bundle):
#   The Supabase anon key is designed to be public; Row Level Security and
#   SECURITY DEFINER functions in supabase/migrations protect the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployment (optional; defaults live in site.config.ts)
# Project site:  VITE_BASE_PATH=/VeletaFinance/
# Custom domain: VITE_BASE_PATH=/
VITE_BASE_PATH=
VITE_SITE_URL=

# NEVER put these in a VITE_ variable or commit them anywhere:
#   SUPABASE_SERVICE_ROLE_KEY, database passwords, access tokens.
